{
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/pending-requests?slot=morning",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/pending-requests?slot=evening",
      "schedule": "0 8 * * *"
    }
  ]
}
