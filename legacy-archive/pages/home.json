ottom:0.8rem\"></div><div class=\"vk_spacer-display-tablet\" style=\"margin-bottom:0.8rem\"></div><div class=\"vk_spacer-display-mobile\" style=\"margin-bottom:0.8rem\"></div></div>\n\n\n\n<h3 class=\"wp-block-heading has-text-align-center is-style-vk-heading-plain vk_block-margin-0--margin-bottom\" style=\"font-size:21px\">日本出発前からしっかり  サポート</h3>\n\n\n\n<div class=\"wp-block-vk-blocks-spacer vk_spacer\"><div class=\"vk_spacer-display-pc\" style=\"margin-bottom:0.8rem\"></div><div class=\"vk_spacer-display-tablet\" style=\"margin-bottom:0.8rem\"></div><div class=\"vk_spacer-display-mobile\" style=\"margin-bottom:0.8rem\"></div></div>\n\n\n\n<p class=\"has-text-align-center vk_block-margin-0--margin-bottom\">グアムのホテル選びやアクティビティ選びなどを日本出発前から相談できる。</p>\n</div>\n\n\n\n<div class=\"wp-block-column has-white-background-color has-background is-layout-flow wp-block-column-is-layout-flow\" style=\"padding-top:4rem;padding-right:2rem;padding-bottom:4rem;padding-left:2rem\">\n<figure class=\"wp-block-image aligncenter size-full is-resized is-style-rounded\" style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px\"><img loading=\"lazy\" decoding=\"async\" width=\"500\" height=\"500\" src=\"https://mokaruguam.com/wp-content/uploads/2025/03/customize-image.png\" alt=\"\" class=\"wp-image-2558\" style=\"object-fit:cover;width:200px;height:200px\" srcset=\"https://mokaruguam.com/wp-content/uploads/2025/03/customize-image.png 500w, https://mokaruguam.com/wp-content/uploads/2025/03/customize-image-300x300.png 300w, https://mokaruguam.com/wp-content/uploads/2025/03/customize-image-150x150.png 150w\" sizes=\"auto, (max-width: 500px) 100vw, 500px\" /></figure>\n\n\n\n<div class=\"wp-block-vk-blocks-spacer vk_spacer\"><div class=\"vk_spacer-display-pc\" style=\"margin-bottom:0.8rem\"></div><div class=\"vk_spacer-display-tablet\" style=\"margin-bottom:0.8rem\"></div><div class=\"vk_spacer-display-mobile\" style=\"margin-bottom:0.8rem\"></div></div>\n\n\n\n<h3 class=\"wp-block-heading has-text-align-center is-style-vk-heading-plain vk_block-margin-0--margin-bottom\" style=\"font-size:21px\">とにかく自由に                       カスタマイズ</h3>\n\n\n\n<div class=\"wp-block-vk-blocks-spacer vk_spacer\"><div class=\"vk_spacer-display-pc\" style=\"margin-bottom:0.8rem\"></div><div class=\"vk_spacer-display-tablet\" style=\"margin-bottom:0.8rem\"></div><div class=\"vk_spacer-display-mobile\" style=\"margin-bottom:0.8rem\"></div></div>\n\n\n\n<p class=\"has-text-align-center vk_block-margin-0--margin-bottom\">観光からレストラン選びまで相談しながら自由に効率よくグアムを満喫できます。</p>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-vk-blocks-spacer vk_spacer vk_spacer-type-margin-top\"><div class=\"vk_block-margin-md--margin-top\"></div></div>\n\n\n\n<div class=\"wp-block-vk-blocks-button vk_button vk_button-color-custom vk_button-align-center\"><a href=\"/strength/\" class=\"vk_button_link btn has-background has-vk-color-primary-background-color btn-md\" role=\"button\" aria-pressed=\"true\" rel=\"noopener\"><div class=\"vk_button_link_caption\"><span class=\"vk_button_link_txt\">詳しく見る</span><i class=\"fa-solid fa-angle-right vk_button_link_after\" aria-hidden=\"true\"></i></div></a></div>\n\n\n\n<div class=\"wp-block-vk-blocks-spacer vk_spacer vk_spacer-type-margin-top\"><div class=\"vk_block-margin-lg--margin-top\"></div></div>\n</div></div>\n\n\n\n<div class=\"wp-block-cover alignfull\" style=\"padding-top:0;padding-bottom:0;min-height:50px;aspect-ratio:unset;\" id=\"faq\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-60 has-background-dim\" style=\"background-color:#5d5d58\"></span><img loading=\"lazy\" decoding=\"async\" width=\"1920\" height=\"2560\" class=\"wp-block-cover__image-background wp-image-2521\" alt=\"\" src=\"https://mokaruguam.com/wp-content/uploads/2025/03/Tumon-Beach-2-1-scaled.jpg\" style=\"object-position:88% 31%\" data-object-fit=\"cover\" data-object-position=\"88% 31%\" srcset=\"https://mokaruguam.com/wp-content/uploads/2025/03/Tumon-Beach-2-1-scaled.jpg 1920w, https://mokaruguam.com/wp-content/uploads/2025/03/Tumon-Beach-2-1-225x300.jpg 225w, https://mokaruguam.com/wp-content/uploads/2025/03/Tumon-Beach-2-1-768x1024.jpg 768w, https://mokaruguam.com/wp-content/uploads/2025/03/Tumon-Beach-2-1-1152x1536.jpg 1152w, https://mokaruguam.com/wp-content/uploads/2025/03/Tumon-Beach-2-1-1536x2048.jpg 1536w\" sizes=\"auto, (max-width: 1920px) 100vw, 1920px\" /><div class=\"wp-block-cover__inner-container is-layout-flow wp-block-cover-is-layout-flow\">\n<div class=\"wp-block-vk-blocks-spacer vk_spacer vk_spacer-type-margin-top\"><div class=\"vk_block-margin-lg--margin-top\"></div></div>\n\n\n\n<div class=\"wp-block-group is-content-justification-center is-nowrap is-layout-flex wp-container-core-group-is-layout-15 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-vk-blocks-icon vk_icon\"><div class=\"vk_icon_frame is-style-noline\"><div class=\"vk_icon_border has-text-color has-luminous-vivid-orange-color\" style=\"width:calc(36px + 0px);height:calc(36px + 0px)\"><i class=\"fa-solid vk_icon_font fa-person-chalkboard\" aria-hidden=\"true\"></i></div></div></div>\n\n\n\n<h2 class=\"wp-block-heading is-style-vk-heading-plain vk_block-margin-0--margin-bottom vk_block-margin-0--margin-top\" style=\"font-size:2rem\">おすすめツアー</h2>\n</div>\n\n\n\n<div class=\"wp-block-vk-blocks-spacer vk_spacer vk_spacer-type-margin-top\"><div class=\"vk_block-margin-lg--margin-top\"></div></div>\n</div></div>\n\n\n\n<div class=\"wp-block-vk-blocks-spacer vk_spacer vk_spacer-type-margin-top\"><div class=\"vk_block-margin-lg--margin-top\"></div></div>\n\n\n\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-12 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image aligncenter size-full is-style-vk-image-rounded vk_block-margin-0--margin-bottom\"><img loading=\"lazy\" decoding=\"async\" width=\"640\" heigh