# ---------------------------------------------------------------------------
# Mokaru Guam site — environment variables
# Copy to `.env.local` for local dev. Set these in Vercel at launch.
# With NONE of these set, the site runs fully in local mode:
#   • booking requests are saved to a local JSON file (.data/db.json)
#   • confirmation emails are logged to the console instead of sent
#   • the Admin area is open (dev only)
# ---------------------------------------------------------------------------

# --- Public site origin (used for OGP / links). No trailing slash. ---
# Vercel preview/prod: https://mokaruguam.vercel.app
# Custom domain later: https://www.mokaruguam.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Analytics 4 (optional) ---
# Measurement ID (G-XXXXXXXXXX). Public — it ships in the page source.
# The production value lives in `.env.production` (committed), so you do NOT
# need it here: leave it unset locally and no tag is rendered, keeping local
# browsing out of the real GA data. Preview deployments are excluded too.
NEXT_PUBLIC_GA_ID=

# --- Supabase (booking request storage in production) ---
# Project Settings -> API. Leave unset locally to use the JSON fallback.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email) ---
# Leave unset to log emails to the server console instead of sending.
RESEND_API_KEY=

# --- Admin dashboard password (HTTP Basic Auth) ---
# REQUIRED in production. If unset in production, the Admin area is locked shut.
# Ignored during local `npm run dev`.
ADMIN_PASSWORD=

# --- Self-service cancellation token secret ---
# HMAC key for signing customer cancel links (/cancel/[token]). Set a long
# random value in production. If unset, falls back to ADMIN_PASSWORD, then to a
# dev-only constant (so local dev/build works). Rotating this invalidates
# previously emailed cancel links.
CANCEL_TOKEN_SECRET=

# --- PayPal (payment: authorize -> capture) ---
# When these are unset, the booking form runs request-only (no online payment).
# PAYPAL_ENV: "sandbox" (default) or "live".
# The secret is server-only. NEXT_PUBLIC_PAYPAL_CLIENT_ID is the browser-safe id.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
